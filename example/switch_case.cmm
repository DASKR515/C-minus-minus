#include "Cmm.h"
#include "stdc--.h"

section "data" { fmt_one:   bits8[] "one\n\0"; }
section "data" { fmt_two:   bits8[] "two\n\0"; }
section "data" { fmt_other: bits8[] "other\n\0"; }

export main;

main() {
    bits32 x;
    x = 2;

    switch (x) {
        case 1: {
            moutf(fmt_one);
            goto exit_switch;
        }
        case 2: {
            moutf(fmt_two);
            goto exit_switch;
        }
        default: {
            moutf(fmt_other);
            goto exit_switch;
        }
    }

exit_switch:
    mexit(0);
}
