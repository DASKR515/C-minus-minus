{
  "name": "C-- (Cmm)",
  "scopeName": "source.cmm",
  "fileTypes": ["cmm"],
  "firstLineMatch": "^\\s*#\\s*include\\s*[\"<]Cmm\\.h[\">]",

  "patterns": [
    { "include": "#preprocessor" },
    { "include": "#comments" },
    { "include": "#section" },
    { "include": "#procedure-definition" },
    { "include": "#goto-label" },
    { "include": "#declarations" },
    { "include": "#primops" },
    { "include": "#keywords" },
    { "include": "#label-definition" },
    { "include": "#constants" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#calls" },
    { "include": "#variables" },
    { "include": "#operators" }
  ],

  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.cmm",
          "begin": "//",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.cmm" } },
          "end": "$"
        },
        {
          "name": "comment.block.cmm",
          "begin": "/\\*",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.cmm" } },
          "end": "\\*/",
          "endCaptures": { "0": { "name": "punctuation.definition.comment.end.cmm" } }
        }
      ]
    },

    "preprocessor": {
      "patterns": [
        {
          "name": "meta.preprocessor.cmm",
          "begin": "^\\s*(#)([ \\t]*)(include)\\b",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.directive.cmm" },
            "3": { "name": "keyword.control.directive.include.cmm" }
          },
          "end": "$",
          "patterns": [
            {
              "name": "string.quoted.other.lt-gt.include.cmm",
              "begin": "(<)",
              "beginCaptures": { "1": { "name": "punctuation.definition.string.begin.cmm" } },
              "end": "(>)",
              "endCaptures": { "1": { "name": "punctuation.definition.string.end.cmm" } }
            },
            {
              "name": "string.quoted.double.include.cmm",
              "begin": "\"",
              "end": "\"",
              "patterns": [
                {
                  "name": "constant.character.escape.cmm",
                  "match": "\\\\(x[0-9a-fA-F]{2}|[0-7]{1,3}|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8}|[abfnrtv\\\\'\"?])"
                }
              ]
            },
            { "include": "#comments" }
          ]
        },
        {
          "name": "meta.preprocessor.cmm",
          "begin": "^\\s*(#)([ \\t]*)(define)\\b([ \\t]*)([A-Za-z_][A-Za-z0-9_]*)?",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.directive.cmm" },
            "3": { "name": "keyword.control.directive.define.cmm" },
            "5": { "name": "entity.name.function.macro.cmm" }
          },
          "end": "(?<!\\\\)$",
          "patterns": [
            {
              "name": "constant.character.escape.line-continuation.cmm",
              "match": "\\\\[ \\t]*$"
            },
            { "include": "#comments" },
            { "include": "#constants" },
            { "include": "#strings" },
            { "include": "#numbers" },
            {
              "match": "\\b(foreign|prim|bits8|bits16|bits32|bits64|float32|float64|gcptr|W_|P_|L_|F_|D_|I8|I16|I32|I64|CInt|CLong)\\b",
              "name": "keyword.control.cmm"
            },
            {
              "match": "\\b(__VA_ARGS__|__LINE__|__FILE__)\\b",
              "name": "variable.language.cmm"
            },
            {
              "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\b",
              "name": "variable.other.read.cmm"
            },
            { "include": "#operators" }
          ]
        },
        {
          "name": "meta.preprocessor.cmm",
          "match": "^\\s*(#)([ \\t]*)\\b(undef|ifdef|ifndef|if|elif|else|endif|error|warning|line|pragma)\\b",
          "captures": {
            "1": { "name": "punctuation.definition.directive.cmm" },
            "3": { "name": "keyword.control.directive.cmm" }
          }
        },
        {
          "name": "meta.preprocessor.invalid.cmm",
          "match": "^\\s*(#)([ \\t]*)[A-Za-z_]"
        }
      ]
    },

    "section": {
      "name": "meta.section.cmm",
      "begin": "\\b(section)\\b\\s*(\"[A-Za-z_][A-Za-z0-9_-]*\"|[A-Za-z_][A-Za-z0-9_]*)\\s*(\\{)",
      "beginCaptures": {
        "1": { "name": "keyword.control.section.cmm" },
        "2": { "name": "string.quoted.double.section.cmm" },
        "3": { "name": "punctuation.section.block.begin.cmm" }
      },
      "end": "(\\})",
      "endCaptures": { "1": { "name": "punctuation.section.block.end.cmm" } },
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#global-label" },
        { "include": "#keywords" },
        { "include": "#primops" },
        { "include": "#constants" },
        { "include": "#numbers" },
        { "include": "#operators" }
      ]
    },

    "global-label": {
      "match": "(?<![A-Za-z0-9_$])([A-Za-z_][A-Za-z0-9_]*)([ \\t]*)(:)",
      "captures": {
        "1": { "name": "entity.name.global.label.cmm" },
        "3": { "name": "punctuation.definition.label.cmm" }
      }
    },

    "procedure-definition": {
      "name": "meta.procedure.cmm",
      "match": "(?<![A-Za-z0-9_$\\.])(?!(?:section|export|import|foreign|prim|if|else|switch|case|default|goto|jump|return|never|unwind|ffi|C_|while|for|do|then|end)\\b)([A-Za-z_][A-Za-z0-9_]*)([ \\t]*)(\\()([^()]*)(\\))([ \\t]*\\{)",
      "captures": {
        "1": { "name": "entity.name.function.cmm" },
        "3": { "name": "punctuation.definition.parameters.begin.cmm" },
        "4": {
          "name": "meta.parameters.cmm",
          "patterns": [
            { "include": "#primitive-types" },
            { "include": "#parameter-names" }
          ]
        },
        "5": { "name": "punctuation.definition.parameters.end.cmm" },
        "6": { "name": "punctuation.section.block.begin.cmm" }
      }
    },

    "primitive-types": {
      "match": "\\b(bits8|bits16|bits32|bits64|bits128|bits256|float16|float32|float64|gcptr|p8|p16|p32|p64|I8|I16|I32|I64|I128|P_|W_|L_|F_|D_|CInt|CLong|CSize|CFloat|CDouble|CLOSURE)\\b",
      "name": "storage.type.cmm"
    },

    "parameter-names": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\b",
      "name": "variable.parameter.cmm"
    },

    "declarations": {
      "patterns": [
        {
          "match": "\\b(export)\\b([ \\t]+)([A-Za-z_][A-Za-z0-9_]*)([ \\t]*)(\\()",
          "captures": {
            "1": { "name": "keyword.control.declaration.cmm" },
            "3": { "name": "entity.name.function.cmm" },
            "5": { "name": "punctuation.definition.parameters.begin.cmm" }
          }
        },
        {
          "match": "\\b(export)\\b([ \\t]+)([A-Za-z_][A-Za-z0-9_]*)(?=[ \\t]*(?:;|\\n|$))",
          "captures": {
            "1": { "name": "keyword.control.declaration.cmm" },
            "3": { "name": "entity.name.global.cmm" }
          }
        },
        {
          "match": "\\b(import)\\b([ \\t]*)(\"[A-Za-z_][A-Za-z0-9_]*\")([ \\t]*)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.declaration.cmm" },
            "3": { "name": "string.quoted.double.import.cmm" },
            "5": { "name": "entity.name.global.import.cmm" }
          }
        },
        {
          "match": "\\b(import)\\b([ \\t]+)([A-Za-z_][A-Za-z0-9_]*)(?=[ \\t]*(?:;|\\n|$))",
          "captures": {
            "1": { "name": "keyword.control.declaration.cmm" },
            "3": { "name": "entity.name.global.import.cmm" }
          }
        }
      ]
    },

    "goto-label": {
      "match": "\\b(goto)\\b([ \\t]+)([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.control.goto.cmm" },
        "2": { "name": "keyword.control.goto.cmm" },
        "3": { "name": "entity.name.label.cmm" }
      }
    },

    "label-definition": {
      "match": "^\\s*(?!(?:case|default|else)\\b)(::)?([A-Za-z_][A-Za-z0-9_]*)([ \\t]*)(:)",
      "captures": {
        "1": { "name": "punctuation.definition.label.cmm" },
        "2": { "name": "entity.name.label.cmm" },
        "4": { "name": "punctuation.definition.label.cmm" }
      }
    },

    "primops": {
      "patterns": [
        {
          "name": "entity.name.function.primitive.cmm",
          "match": "(?<![A-Za-z0-9_)\\]])%[ \\t]*(bits2float|float2bits|f2f16|f2f32|f2f64|f2i16|f2i32|f2i64|i2f16|i2f32|i2f64|i2i16|i2i32|i2i64|lobits8|lobits16|lobits32|lobits64|sx8|sx16|sx32|sx64|zx8|zx16|zx32|zx64|fadd|fsub|fmul|fquot|fabs16f|fabs32f|fabs64f|sqrt16f|sqrt32f|sqrt64f|log16f|log32f|log64f|log1p16f|log1p32f|log1p64f|exp16f|exp32f|exp64f|expM132f|expM164f|sin16f|sin32f|sin64f|cos16f|cos32f|cos64f|tan16f|tan32f|tan64f|asin16f|asin32f|asin64f|acos16f|acos32f|acos64f|atan16f|atan32f|atan64f|sinh16f|sinh32f|sinh64f|cosh16f|cosh32f|cosh64f|tanh16f|tanh32f|tanh64f|asinh16f|asinh32f|asinh64f|acosh16f|acosh32f|acosh64f|atan216f|atan264f|pow16f|pow32f|pow64f|memcpy|memmove|memset|memcmp|quiesce|relaxed|acquire|release|seq_cst)\\b"
        },
        {
          "name": "entity.name.function.primitive.cmm",
          "match": "(?<![A-Za-z0-9_)\\]])%[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },

    "keywords": {
      "patterns": [
        { "match": "\\b(section)\\b", "name": "keyword.control.section.cmm" },
        { "match": "\\b(export|import)\\b", "name": "keyword.control.declaration.cmm" },
        { "match": "\\b(foreign)\\b", "name": "keyword.control.foreign.cmm" },
        { "match": "\\b(ffi|C_)\\b", "name": "keyword.control.foreign.cmm" },
        { "match": "\\b(if|else|switch|case|default)\\b", "name": "keyword.control.conditional.cmm" },
        { "match": "\\b(goto)\\b", "name": "keyword.control.goto.cmm" },
        { "match": "\\b(jump)\\b", "name": "keyword.control.jump.cmm" },
        { "match": "\\b(return)\\b", "name": "keyword.control.return.cmm" },
        { "match": "\\b(prim)\\b", "name": "keyword.other.prim.cmm" },
        { "match": "\\b(never|unwind)\\b", "name": "keyword.control.unwind.cmm" },
        { "include": "#primitive-types" },
        {
          "match": "\\b(Sp|Hp|HpLim|HpAlloc|BaseReg|currentTSO|CurrentTSO|StgTSO|StgTSO_|StgStop|CurrentNursery)\\b",
          "name": "variable.language.register.cmm"
        }
      ]
    },

    "constants": {
      "patterns": [
        { "name": "support.constant.pointer-annotation.cmm", "match": "\"ptr\"" },
        { "name": "constant.language.cmm", "match": "\\b(true|false|NULL|null|#undefined)\\b" }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.cmm",
          "match": "\\b([0-9][0-9_]*\\.[0-9][0-9_]*([eE][-+]?[0-9]+)?)"
        },
        { "name": "constant.numeric.hex.cmm", "match": "\\b(0[xX][0-9a-fA-F][0-9a-fA-F_]*)" },
        { "name": "constant.numeric.octal.cmm", "match": "\\b(0[0-7][0-7_]*)\\b" },
        { "name": "constant.numeric.integer.cmm", "match": "\\b([0-9][0-9_]*)\\b" }
      ]
    },

    "calls": {
      "patterns": [
        {
          "match": "(?<![A-Za-z0-9_$\\.%&|^!~*/+<>=:\\-\\[])([A-Za-z_][A-Za-z0-9_]*)(?=[ \\t]*\\()",
          "captures": { "1": { "name": "entity.name.function.call.cmm" } }
        }
      ]
    },

    "variables": {
      "patterns": [
        {
          "match": "(?<![A-Za-z0-9_$.])([A-Za-z_][A-Za-z0-9_]*)([ \\t]*)(=(?!=))",
          "captures": {
            "1": { "name": "variable.other.assigned.cmm" },
            "3": { "name": "keyword.operator.assignment.cmm" }
          }
        },
        {
          "match": "(?<![A-Za-z0-9_$.])([A-Za-z_][A-Za-z0-9_]*)\\b",
          "name": "variable.other.read.cmm"
        }
      ]
    },

    "strings": {
      "name": "string.quoted.double.cmm",
      "begin": "\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.cmm" } },
      "end": "\"",
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.cmm" } },
      "patterns": [
        {
          "name": "constant.character.escape.cmm",
          "match": "\\\\(x[0-9a-fA-F]{2}|[0-7]{1,3}|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8}|[abfnrtv\\\\'\"?])"
        },
        { "name": "invalid.illegal.unknown-escape.cmm", "match": "\\\\." }
      ]
    },

    "operators": {
      "patterns": [
        { "name": "keyword.operator.comparison.cmm", "match": "(==|!=|<=|>=|<<|>>|&&|\\|\\||<|>)" },
        { "name": "keyword.operator.assignment.cmm", "match": "=" },
        { "name": "keyword.operator.arithmetic.cmm", "match": "(\\+|-|\\*|/|%)" },
        { "name": "keyword.operator.bitwise.cmm", "match": "(&|\\||\\^|~|!)" },
        { "name": "punctuation.separator.colon.cmm", "match": ":" },
        { "name": "punctuation.separator.question.cmm", "match": "\\?" },
        { "name": "punctuation.separator.comma.cmm", "match": "," },
        { "name": "punctuation.terminator.statement.cmm", "match": ";" },
        { "name": "punctuation.section.block.begin.cmm", "match": "\\{" },
        { "name": "punctuation.section.block.end.cmm", "match": "\\}" },
        { "name": "punctuation.definition.parameters.begin.cmm", "match": "\\(" },
        { "name": "punctuation.definition.parameters.end.cmm", "match": "\\)" },
        { "name": "punctuation.definition.square.bracket.begin.cmm", "match": "\\[" },
        { "name": "punctuation.definition.square.bracket.end.cmm", "match": "\\]" }
      ]
    }
  }
}